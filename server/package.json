{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "kill": "npx kill-port 8080",
    "predev": "npm run kill",
    "dev": "dotenv -e .env.development -- tsx watch src/server.ts",
    "prod": "dotenv -e .env.production -- tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "convenios": "tsx src/scripts/convenios/conveniosToXlsx.ts",
    "start": "node dist/server.js",
    "start:prod": "dotenv -e .env.production -- node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "seed": "npm run kill && dotenv -e .env.development -- tsx src/scripts/seedOnStart.ts",
    "fix:imported-users:dry": "dotenv -e .env.production -v DRY_RUN=true -- tsx src/scripts/assignImportedUsersRoleAndDNI.ts",
    "fix:imported-users": "dotenv -e .env.production -- tsx src/scripts/assignImportedUsersRoleAndDNI.ts",
    "fix:imported-users:all:dry": "dotenv -e .env.production -v DRY_RUN=true -v SCOPE=all -- tsx src/scripts/assignImportedUsersRoleAndDNI.ts",
    "fix:imported-users:all": "dotenv -e .env.production -v SCOPE=all -- tsx src/scripts/assignImportedUsersRoleAndDNI.ts",
    "diag:missing-members": "dotenv -e .env.production -- tsx src/scripts/diagnoseMissingProjectMembers.ts",
    "backfill:roles-frame:dry": "dotenv -e .env.production -v DRY=true -- tsx src/scripts/backfillUserRolesFrame.ts",
    "backfill:roles-frame": "dotenv -e .env.production -- tsx src/scripts/backfillUserRolesFrame.ts",
    "fix:reemplazo-areas:dry": "dotenv -e .env.production -v DRY=true -- tsx src/scripts/backfillReplacementAreaShifts.ts",
    "fix:reemplazo-areas": "dotenv -e .env.production -- tsx src/scripts/backfillReplacementAreaShifts.ts",
    "empresas:obras-sociales:dry": "dotenv -e .env.production -v DRY_RUN=true -- tsx src/scripts/migrarObrasSocialesPorEmpresa.ts",
    "empresas:obras-sociales": "dotenv -e .env.production -- tsx src/scripts/migrarObrasSocialesPorEmpresa.ts",
    "obra-social:a-contratos:dry": "dotenv -e .env.production -v DRY_RUN=true -- tsx src/scripts/migrarObraSocialAContratos.ts",
    "obra-social:a-contratos": "dotenv -e .env.production -- tsx src/scripts/migrarObraSocialAContratos.ts",
    "obra-social:drop-usuario": "dotenv -e .env.production -v DROP_USER=true -- tsx src/scripts/migrarObraSocialAContratos.ts",
    "categorias:auditar": "dotenv -e .env.production -- tsx src/scripts/auditarCategorias.ts",
    "categorias:auditar-nombres": "dotenv -e .env.production -- tsx src/scripts/auditarNombresCategorias.ts",
    "categorias:importar:dry": "dotenv -e .env.production -v DRY_RUN=true -- tsx src/scripts/importarCategoriasArca.ts",
    "categorias:importar": "dotenv -e .env.production -- tsx src/scripts/importarCategoriasArca.ts",
    "tipos-servicio:grupo:dry": "dotenv -e .env.production -v DRY_RUN=true -- tsx src/scripts/backfillGrupoTipoServicio.ts",
    "tipos-servicio:grupo": "dotenv -e .env.production -- tsx src/scripts/backfillGrupoTipoServicio.ts",
    "test:additive": "tsx --test src/utils/additiveSync.test.ts",
    "test:constancia": "tsx --test src/utils/constanciaPdf.test.ts",
    "test:obras-sociales": "tsx --test src/services/obrasSocialesLoteService.test.ts",
    "test:nomenclatura": "tsx --test src/utils/nomenclatura.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@supabase/storage-js": "^2.12.2",
    "@supabase/supabase-js": "^2.58.0",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.4",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "bullmq": "^5.60.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "docxtemplater": "^3.69.0",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^7.1.0",
    "html-pdf-node": "^1.0.8",
    "html-to-docx": "^1.8.0",
    "imapflow": "^1.7.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-forge": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pizzip": "^3.2.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.21",
    "@types/node-forge": "^1.3.14",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
