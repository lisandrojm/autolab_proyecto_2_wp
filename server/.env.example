# Variables del servidor. Copiar a `.env.development` / `.env.production` y completar.
# NINGÚN valor real va acá: este archivo se commitea, los otros no.

NODE_ENV=development
PORT=8080
USE_HTTPS=false
API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173

# --- Base de datos ---
MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/
MONGO_DB_NAME=weprodu_dev

# --- Segundo destino de los backups ---
# Cada copia se sube a Dropbox y ADEMÁS se clona como una base aparte, llamada
# `<prefijo>_<fecha>_<hora>`, que se puede abrir y consultar desde Atlas sin importar nada.
#
# Por defecto se clona en el MISMO cluster de `MONGO_URI`: no hace falta configurar nada. Sirve para
# el caso común —alguien borró algo, un script escribió mal— pero NO protege contra la caída o la
# pérdida del cluster: para eso está la copia en Dropbox.
#
# `MONGO_URI_BACKUP` solo hace falta para clonar en OTRO cluster, que sí es un backup contra desastre.
MONGO_URI_BACKUP=
# Prefijo de las bases de copia. Si no se declara, se usa el nombre de MONGO_DB_NAME — que es lo
# recomendado: con el límite de 38 bytes de Atlas Free/Flex, un prefijo más largo obliga a recortar el
# nombre y meterle un hash, y deja de ser legible.
#   weprodu_production_integration  ->  weprodu_production_integration_bkpA  (35 bytes) ✓
MONGO_DB_NAME_BACKUP=

# La copia alterna entre dos slots (`_bkpA` / `_bkpB`) en vez de llevar la fecha en el nombre: no entra
# en 38 bytes. La fecha vive adentro de la copia, en la colección `_backup_meta`.
# `legacy` vuelve al esquema con fecha, que solo sirve en clusters sin ese límite (M10+).
MONGO_BACKUP_ESTRATEGIA=slots

# Límites de Atlas Free/Flex. Van acá y no hardcodeados porque en un M10 dejan de aplicar.
MONGO_BACKUP_MAX_DB_BYTES=38
MONGO_BACKUP_MAX_NS_BYTES=95
MONGO_BACKUP_MAX_COLECCIONES=500

# Si el slot destino ya existe (es la copia de hace dos ciclos), se reemplaza.
MONGO_BACKUP_REEMPLAZAR_SLOT=true

# --- Auth ---
JWT_SECRET=<un-secreto-largo-y-aleatorio>
JWT_EXPIRES_IN=7d
TENANCY_HEADER=x-tenant-id

# --- Integración FRAME ---
FRAME_API_URL=
FRAME_API_USER=
FRAME_API_PASSWORD=

# --- Seed inicial ---
SEED_ON_START=false
SEED_TENANT_SLUG=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASS=
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASS=
DEFAULT_TENANT_USER_PASSWORD=

# --- Deploy del frontend (Vercel) ---
VERCEL_API_TOKEN=
VERCEL_APP=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
