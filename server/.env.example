# Variables del servidor. Copiar a `.env.development` / `.env.production` y completar.
# NINGÚN valor real va acá: este archivo se commitea, los otros no.

NODE_ENV=development
PORT=8080
USE_HTTPS=false
API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173

# --- Base de datos ---
MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/
MONGO_DB_NAME=weprodu_dev

# --- Segundo destino de los backups ---
# Cada copia se sube a Dropbox y ADEMÁS se clona como una base aparte, llamada
# `<prefijo>_<fecha>_<hora>`, que se puede abrir y consultar desde Atlas sin importar nada.
#
# Por defecto se clona en el MISMO cluster de `MONGO_URI`: no hace falta configurar nada. Sirve para
# el caso común —alguien borró algo, un script escribió mal— pero NO protege contra la caída o la
# pérdida del cluster: para eso está la copia en Dropbox.
#
# `MONGO_URI_BACKUP` solo hace falta para clonar en OTRO cluster, que sí es un backup contra desastre.
MONGO_URI_BACKUP=
# Prefijo de las bases de copia. Conviene uno CORTO: al nombre se le pega la fecha y la hora, y el
# total no puede pasar los 38 bytes de Atlas Free/Flex.
#   weprodu                         ->  weprodu_2026_09_10_04:34                 24 bytes ✓
#   (sin declarar: MONGO_DB_NAME)   ->  weprodu_production_in_2026_09_10_04:34   38 bytes ✓ (justo)
MONGO_DB_NAME_BACKUP=weprodu

# `fecha` (por defecto): el nombre lleva día y hora — weprodu_2026_09_10_04:34 — que es lo que se lee
# desde el listado de Atlas sin abrir la copia. Entra en 38 bytes con un prefijo corto.
# `slots`: alterna `_bkpA` / `_bkpB` y guarda la fecha adentro, en la colección `_backup_meta`. Solo
# hace falta si el prefijo es tan largo que la fecha no entra.
MONGO_BACKUP_ESTRATEGIA=fecha

# Límites de Atlas Free/Flex. Van acá y no hardcodeados porque en un M10 dejan de aplicar.
MONGO_BACKUP_MAX_DB_BYTES=38
MONGO_BACKUP_MAX_NS_BYTES=95
MONGO_BACKUP_MAX_COLECCIONES=500

# Si el slot destino ya existe (es la copia de hace dos ciclos), se reemplaza.
MONGO_BACKUP_REEMPLAZAR_SLOT=true

# --- Auth ---
JWT_SECRET=<un-secreto-largo-y-aleatorio>
JWT_EXPIRES_IN=7d
TENANCY_HEADER=x-tenant-id

# --- Integración FRAME ---
FRAME_API_URL=
FRAME_API_USER=
FRAME_API_PASSWORD=

# --- Seed inicial ---
SEED_ON_START=false
SEED_TENANT_SLUG=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASS=
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASS=
DEFAULT_TENANT_USER_PASSWORD=

# --- Deploy del frontend (Vercel) ---
VERCEL_API_TOKEN=
VERCEL_APP=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ───────────────── Tango (catálogo de centros de costo) ─────────────────
# El catálogo de centros de costo se trae del proceso 1656, registro 1, de cada empresa.
# Sin TANGO_API_URL la sincronización queda apagada y el catálogo se carga por el import de JSON.
TANGO_API_URL=
TANGO_API_USER=
TANGO_API_PASSWORD=
# O un token fijo, si la API no tiene login:
TANGO_API_TOKEN=
# Cómo viaja el id de la empresa en el request: query (default) | header | path
TANGO_EMPRESA_EN=query
TANGO_EMPRESA_CLAVE=empresa
