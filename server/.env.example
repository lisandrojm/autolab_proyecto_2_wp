# Variables del servidor. Copiar a `.env.development` / `.env.production` y completar.
# NINGÚN valor real va acá: este archivo se commitea, los otros no.

NODE_ENV=development
PORT=8080
USE_HTTPS=false
API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173

# --- Base de datos ---
MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/
MONGO_DB_NAME=weprodu_dev

# --- Segundo destino de los backups (opcional) ---
# Cada copia se sube a Dropbox y ADEMÁS se guarda acá, en GridFS, conservando solo la última.
# Tiene que apuntar a OTRO cluster u otra base: si apunta a la misma que `MONGO_URI`, el server se
# niega a usarlo — una copia guardada adentro de lo que respalda no es un backup, y además haría que
# cada dump se respalde a sí mismo.
# Sin esta variable, el backup funciona igual y solo va a Dropbox.
MONGO_URI_BACKUP=
# Opcional: si la URI no trae el nombre de la base, o si querés forzar otro.
MONGO_DB_NAME_BACKUP=

# --- Auth ---
JWT_SECRET=<un-secreto-largo-y-aleatorio>
JWT_EXPIRES_IN=7d
TENANCY_HEADER=x-tenant-id

# --- Integración FRAME ---
FRAME_API_URL=
FRAME_API_USER=
FRAME_API_PASSWORD=

# --- Seed inicial ---
SEED_ON_START=false
SEED_TENANT_SLUG=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASS=
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASS=
DEFAULT_TENANT_USER_PASSWORD=

# --- Deploy del frontend (Vercel) ---
VERCEL_API_TOKEN=
VERCEL_APP=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
