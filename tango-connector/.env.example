# Token de la API de Tango para scripts/api/leer.py (pruebas manuales). El servicio no lo
# usa: guarda un token por empresa, cifrado, en la base.
TANGO_API_TOKEN=

# --- Servicio ---
# Solo localhost: en el VPS se publica por nginx. No usar 0.0.0.0.
HOST=127.0.0.1
PORT=3100
NODE_ENV=development

# Postgres (docker-compose.yml lo levanta en el 5433)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=tango_connector
DB_USER=tango_connector
DB_PASSWORD=solo-desarrollo

# Clave para cifrar los tokens de Tango en la base: 32 bytes en base64.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO=

# Catálogo relevado que usa el servicio (metadatos y validaciones)
CATALOGO_DIR=docs/tango/catalogo/2026-10-08

# Límites hacia Tango
TANGO_TIMEOUT_MS=120000
TANGO_CONCURRENCIA=4
TANGO_PAGE_SIZE_MAX=1000

# Usuario de la WEB de Tango (ADR 0003): para los datos que la API no expone. Se carga cifrado
# en la base con `npm run cli -- tenant:credenciales-web <tenant>` y lo usan los tests de
# contrato (`npm run test:contrato`). En el VPS NO se guarda acá: se pasa por stdin solo al
# correr el CLI (ver docs/operacion/deploy.md). Después de cambiarlo, reiniciar el servicio.
TANGO_WEB_TIMEOUT_MS=20000
TANGO_WEB_USUARIO=
TANGO_WEB_PASSWORD=
# Para los tests de contrato (opcionales)
TANGO_WEB_URL=http://servertango:17000
TANGO_WEB_EMPRESA=13
