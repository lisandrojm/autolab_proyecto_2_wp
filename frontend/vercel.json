{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://autolab.fun:7001/api/$1"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://autolab.fun:7001/storage/:path*"
    },
    {
      "source": "/asistente/descargas/(.*)",
      "destination": "/asistente/descargas/$1"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/"
    }
  ]
}
